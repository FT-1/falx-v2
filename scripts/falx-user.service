# =============================================================================
# Project: FALX V2
# Lead Architect & Owner: FT-1
# Description: systemd service for the eBPF/XDP loader (scripts/falx-user.service).
#              Loads the kernel program, attaches it to the configured
#              interface, and pins maps under /sys/fs/bpf/falx/. Must be
#              running before falxd.service so the control plane can open
#              the pinned maps.
#
#              Install: cp scripts/falx-user.service /etc/systemd/system/
#              Enable:  systemctl daemon-reload && systemctl enable --now falx-user
#
#              To override the interface or XDP mode without editing this file,
#              drop a unit override:
#                  systemctl edit falx-user
#              and set, e.g.:
#                  [Service]
#                  ExecStart=
#                  ExecStart=/usr/local/bin/falx-user --config /etc/falx/falx.toml -i ens33 -m skb
# =============================================================================

[Unit]
Description=FALX V2 eBPF/XDP Loader (pins maps to /sys/fs/bpf/falx)
Documentation=https://github.com/ft-1/falx-v2
After=network-online.target
Wants=network-online.target
# Ensure BPF filesystem is mounted before we try to pin into it
RequiresMountsFor=/sys/fs/bpf
# StartLimit* live in [Unit], not [Service] — systemd silently ignores them
# when placed in [Service], which disables rate-limiting and lets a broken
# unit restart-spam thousands of times.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/falx

ExecStart=/usr/local/bin/falx-user \
    --config /etc/falx/falx.toml

ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

TimeoutStopSec=30

Restart=on-failure
RestartSec=5s

# ── Hardening ─────────────────────────────────────────────────────────────────
# BPF/XDP attach requires these capabilities
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN

NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
# systemd auto-creates these with correct ownership and makes them RW under
# the namespace, even with ProtectSystem=strict:
#   ConfigurationDirectory=falx → /etc/falx
#   LogsDirectory=falx          → /var/log/falx
#   RuntimeDirectory=falx       → /run/falx  (symlinked from /var/run/falx)
#   StateDirectory=falx         → /var/lib/falx
# /sys/fs/bpf is a pre-existing kernel mount, so it stays in ReadWritePaths;
# the loader creates the /sys/fs/bpf/falx/ subdir on first start.
ConfigurationDirectory=falx
LogsDirectory=falx
RuntimeDirectory=falx
StateDirectory=falx
ReadWritePaths=/sys/fs/bpf
ProtectHome=yes
# ProtectKernelTunables=no — required for BPF map operations (systemd would
# parse "no  # ..." as the value, so the comment must live on its own line)
ProtectKernelTunables=no
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service @network-io @basic-io bpf perf_event_open

# Resource limits
LimitNOFILE=1048576
# LimitMEMLOCK=infinity required for BPF map allocation
LimitMEMLOCK=infinity
# OOMScoreAdjust=-900 — prefer to kill other processes during OOM
OOMScoreAdjust=-900

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falx-user

[Install]
WantedBy=multi-user.target
