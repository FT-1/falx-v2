# =============================================================================
# Project: FALX V2
# Lead Architect & Owner: FT-1
# Description: Dockerfile for falxd (docker/Dockerfile.falxd).
#              Multi-stage build: Rust (eBPF) + Go (control plane).
# =============================================================================

# ── Stage 1: Build eBPF kernel program (Rust/Aya) ────────────────────────────
FROM rust:1.79-slim AS ebpf-builder
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    llvm clang libelf-dev linux-headers-generic pkg-config ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN rustup toolchain install nightly --component rust-src && \
    rustup target add bpfel-unknown-none --toolchain nightly && \
    cargo install bpf-linker

WORKDIR /build
COPY ebpf-kern/  ./ebpf-kern/
COPY ebpf-user/  ./ebpf-user/
COPY Cargo.toml  ./
COPY .cargo/     ./.cargo/

RUN cd ebpf-kern && \
    CARGO_TARGET_BPFEL_UNKNOWN_NONE_RUSTFLAGS="-C panic=abort" \
    cargo +nightly build \
      --target bpfel-unknown-none \
      -Z build-std=core \
      --release

RUN cd ebpf-user && cargo build --release

# ── Stage 2: Build Go control plane ─────────────────────────────────────────
FROM golang:1.22-bookworm AS go-builder

# VERSION — semver string injected at build time (e.g. git describe --tags --always)
ARG VERSION=dev
# BUILD_TIME — RFC-3339 UTC timestamp for the binary's version string (e.g. date -u +%Y%m%dT%H%M%SZ)
ARG BUILD_TIME

WORKDIR /build
COPY control-plane/ ./control-plane/
COPY ipc/           ./ipc/

WORKDIR /build/control-plane
RUN go mod download
RUN CGO_ENABLED=1 \
    GOOS=linux GOARCH=amd64 \
    go build \
      -ldflags="-s -w -X main.Version=${VERSION} -X main.BuildTime=${BUILD_TIME}" \
      -o /out/falxd \
      ./cmd/falxd/...

# ── Stage 3: Runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libelf1 libbpf1 ca-certificates curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create dedicated non-root system user (UID/GID 1000) — security hardening
RUN groupadd -r -g 1000 falx && useradd -r -u 1000 -g falx -s /sbin/nologin falx

# Prepare runtime directories with correct ownership before switching user
RUN install -d -m 750 -o falx -g falx \
      /etc/falx /etc/falx/keys \
      /var/log/falx /var/lib/falx /var/run/falx

# Use --chown at COPY time — avoids a separate chmod/chown RUN layer
COPY --from=ebpf-builder --chown=falx:falx /build/ebpf-user/target/release/falx-user /usr/local/bin/falx-user
COPY --from=go-builder   --chown=falx:falx /out/falxd                                  /usr/local/bin/falxd
COPY --chown=falx:falx   configs/falx.toml                                              /etc/falx/falx.toml

# BPF/XDP programs still require root capabilities (CAP_BPF, CAP_NET_ADMIN).
# The USER directive runs the process as non-root by default; operators must
# grant the required capabilities via --cap-add or setcap rather than running
# the container as root (principle of least privilege).
USER falx

ENV FALX_IFACE=eth0 FALX_XDP_MODE=native
EXPOSE 9090

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD curl -sf http://localhost:9090/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/falxd"]
CMD ["--config", "/etc/falx/falx.toml"]
